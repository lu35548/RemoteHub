# ─── 必需（缺失启动即报错）───
DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me-at-least-32-chars-long!!
ENCRYPTION_KEY=<base64 编码的 32 字节密钥>
ADMIN_PASSWORD=Admin123456!

# ─── 可选 ───
# ADMIN_USERNAME=admin
# PORT=3001
# LOG_LEVEL=info
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
# CORS_ORIGIN=http://localhost:3000          # 逗号分隔多 origin
# FRONTEND_URL=http://localhost:3000         # 票 #28：admin 代重置拼链接用；空 = 同源相对链接
# RATE_LIMIT_LOGIN_MAX=5                     # 次/分钟
# RATE_LIMIT_REGISTER_MAX=3
# RATE_LIMIT_REFRESH_MAX=20
# RATE_LIMIT_GENERAL_MAX=200
# RATE_LIMIT_FORGOT_PASSWORD_MAX=3           # 票 #28：forgot-password 次/小时/IP
# PASSWORD_RESET_TOKEN_EXPIRES_HOURS=1       # 票 #28：重置 token 有效期
# PASSWORD_RESET_MAX_PER_USER=3              # 票 #28：每用户最大有效 token 数
# AUDIT_RETENTION_DAYS=90
