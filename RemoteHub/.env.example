# RemoteHub Environment Configuration
# Copy this file to .env.local and update with your values

# API Configuration
VITE_USE_API=false
VITE_API_BASE_URL=http://localhost:3001/api/v1

# API Timeout and Retry Configuration (optional)
VITE_API_TIMEOUT=10000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000

# Environment Type (development, production)
VITE_ENVIRONMENT=development

# Database Configuration (will be moved to backend)
# VITE_DB_TYPE=mysql
# VITE_DB_HOST=localhost
# VITE_DB_PORT=3306
# VITE_DB_NAME=remotehub
# VITE_DB_USERNAME=root
# VITE_DB_PASSWORD=

# AI Configuration (REMOVED - no longer needed)
# GEMINI_API_KEY=
# API_KEY=

# Application Configuration
VITE_APP_TITLE=RemoteHub - 团队远程协作平台
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_DATABASE_CONFIG=true
VITE_ENABLE_CONNECTION_TESTING=true
VITE_ENABLE_ADMIN_PANEL=true