# 开发环境配置
NODE_ENV=development
PORT=3001

# 数据库配置 - 使用Mock数据库
USE_MOCK_DB=true
DB_TYPE=mock
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=remotehub_dev
DB_USERNAME=root
DB_PASSWORD=password

# JWT配置
JWT_SECRET=development_secret_key_for_testing_only_do_not_use_in_production
JWT_EXPIRES_IN=7d

# CORS配置
CORS_ORIGIN=http://localhost:3000

# 日志配置
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# 备份配置
BACKUP_DIR=./backups
MAX_BACKUPS=10

# 安全配置
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# WebSocket配置
WS_PORT=3002

# Redis配置 - 使用Mock Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0